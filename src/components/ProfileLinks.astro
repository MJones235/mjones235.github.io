---
import { site } from '../data/site';

interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;

type Entry = {
  key: string;
  label: string;
  href: string;
  external: boolean;
};

const raw: (Entry | null)[] = [
  site.email !== 'TODO'
    ? { key: 'email', label: 'Email', href: `mailto:${site.email}`, external: false }
    : null,
  site.links.github !== 'TODO'
    ? { key: 'github', label: 'GitHub', href: site.links.github, external: true }
    : null,
  site.links.linkedin !== 'TODO'
    ? { key: 'linkedin', label: 'LinkedIn', href: site.links.linkedin, external: true }
    : null,
  site.links.orcid !== 'TODO'
    ? { key: 'orcid', label: 'ORCID', href: site.links.orcid, external: true }
    : null,
];

const entries = raw.filter((e): e is Entry => e !== null);
---

{
  entries.length > 0 && (
    <ul class:list={['profile-links', `is-${size}`]}>
      {entries.map((entry) => (
        <li>
          <a
            href={entry.href}
            rel={entry.external ? 'me noopener' : undefined}
            target={entry.external ? '_blank' : undefined}
          >
            <span class="icon" aria-hidden="true">
              {entry.key === 'email' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
              {entry.key === 'github' && (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 1.5A10.5 10.5 0 0 0 8.68 22c.52.1.71-.23.71-.5v-1.77c-2.9.63-3.52-1.4-3.52-1.4-.47-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.93 1.6 2.45 1.14 3.05.87.1-.68.36-1.14.66-1.4-2.32-.27-4.76-1.16-4.76-5.16 0-1.14.4-2.07 1.07-2.8-.1-.27-.46-1.33.1-2.76 0 0 .88-.28 2.88 1.07a9.9 9.9 0 0 1 5.24 0c2-1.35 2.88-1.07 2.88-1.07.56 1.43.2 2.49.1 2.76.67.73 1.07 1.66 1.07 2.8 0 4-2.45 4.88-4.78 5.14.37.33.71.97.71 1.96v2.9c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z" />
                </svg>
              )}
              {entry.key === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
                </svg>
              )}
              {entry.key === 'orcid' && (
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0ZM7.37 18.16H5.62V7.98h1.75v10.18ZM6.5 6.8a1.02 1.02 0 1 1 0-2.03 1.02 1.02 0 0 1 0 2.03Zm11.9 8.24c0 2.17-1.72 3.12-4.36 3.12h-3.6V7.98h3.6c2.64 0 4.36 1.5 4.36 3.7v3.36Zm-1.8-3.28c0-1.6-1-2.53-2.72-2.53h-1.7v7.4h1.7c1.55 0 2.72-.78 2.72-2.53v-2.34Z" />
                </svg>
              )}
            </span>
            <span class={size === 'sm' ? 'visually-hidden' : 'label'}>{entry.label}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .is-sm {
    gap: var(--space-md);
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .profile-links a:hover {
    color: var(--accent);
  }

  .icon {
    display: inline-flex;
    color: currentColor;
  }

  .icon svg {
    width: 1.25em;
    height: 1.25em;
  }

  .is-sm .icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>
